						<div
							class="bg-dark text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
							style="width: 85px; height: 85px">
							<i class="bi bi-house-door fs-1"></i>
						</div>

						<!-- CARD CONTENT -->
						<h3 class="fw-bold mb-3">Return Home</h3>

						<p class="text-secondary mb-4">
							Go back to the homepage and continue your cooking journey.
						</p>

						<!-- CARD ACTION -->
						<a href="/" class="btn btn-dark rounded-pill px-4"> Go Home </a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
