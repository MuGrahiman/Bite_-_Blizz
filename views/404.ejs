<!-- ===================================================== -->
<!-- HERO SECTION -->
<!-- ===================================================== -->
<section class="position-relative overflow-hidden">
	<!-- ===================================================== -->
	<!-- 404 ERROR CODE -->
	<!-- ===================================================== -->
	<div
		class="d-flex align-items-center position-absolute start-50 top-0 translate-middle-x gap-5 fw-bold text-muted">
		<!-- LEFT 4 -->
		<span style="font-size: 18rem; line-height: 1"> 4 </span>

		<!-- ANIMATED ERROR ZERO -->
		<span
			style="
				color: #dc3545;
				font-size: 18rem;
				line-height: 1;
				animation: plateShake 5s ease-in-out infinite;
			">
			0
		</span>

		<!-- RIGHT 4 -->
		<span style="font-size: 18rem; line-height: 1"> 4 </span>
	</div>

	<!-- ===================================================== -->
	<!-- HERO IMAGE CONTENT -->
	<!-- ===================================================== -->

	<div class="mx-auto mb-5">
		<div class="position-relative">
			<!-- CHEF ILLUSTRATION -->
			<img
				src="/img/404.png"
				width="607"
				height="510"
				class="d-block mx-auto img-fluid floating"
				loading="eager"
				alt="Confused chef unable to find recipe" />

			<!-- FLOATING MESSAGE CARD -->
			<div
				class="position-absolute bottom-0 start-50 translate-middle-x bg-white shadow rounded-5 p-4 d-none d-md-block border">
				<div class="d-flex align-items-start gap-3">
					<!-- WARNING ICON -->
					<div
						class="bg-warning rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
						style="width: 55px; height: 55px">
						<i class="bi bi-exclamation-lg fs-3 text-danger"></i>
					</div>

					<!-- MESSAGE CONTENT -->
					<div>
						<h5 class="fw-bold mb-1">Looks Like You’re Lost In The Kitchen</h5>

						<p class="text-secondary small mb-0">
							Our chef can’t find this recipe either.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- ===================================================== -->
<!-- ERROR CONTENT SECTION-->
<!-- ===================================================== -->
<section class="text-center">
	<!-- ERROR BADGE -->
	<span class="badge text-dark border rounded-pill px-3 py-2 mb-4 shadow-sm">
		ERROR • 404
	</span>

	<!-- ERROR HEADING -->
	<h1 class="display-3 fw-bold lh-1 mb-4 text-muted">
		<span class="text-danger">Oops!</span> <br />
		This Recipe Never Made It To The Table.
	</h1>

	<!-- ERROR DESCRIPTION -->
	<p class="lead text-secondary mb-4">
		Looks like we can’t find the recipe you were searching for.

		<br />

		Let’s get you back to something delicious.
	</p>

	<!-- PRIMARY ACTION -->
	<div class="d-flex flex-wrap justify-content-center mb-5">
		<a
			href="/"
			class="btn btn-outline-dark hero-btn btn-lg px-4 py-3 rounded-pill error-page-btn shadow">
			<i class="bi bi-house-door me-2"></i>

			Take Me Back To The Kitchen
		</a>
	</div>
</section>

<!-- ===================================================== -->
<!-- QUICK NAVIGATION SECTION -->
