<!-- ===================================================== -->
<!-- SAFE DEFAULTS -->
<!-- ===================================================== -->

<%
	const validationErrors = locals.validationErrors || {};
	const oldValues = locals.formData || {};
%>
<!-- ===================================================== -->
<!-- GLOBAL ALERTS -->
<!-- ===================================================== -->
<% console.log("Debugging user object:", validationErrors) %>
<% console.log("Debugging cona object:", locals.conaErrors) %>

<% if (locals.successMessage) { %>
    <%- include('./components/alert', {
        alertMessage: locals.successMessage,
        alertColor: 'success'
    }) %>
<% } %>

<% if (locals.errorMessage) { %>
    <%- include('./components/alert', {
        alertMessage: locals.errorMessage,
        alertColor: 'danger'
    }) %>
<% } %>


<!-- ===================================================== -->
<!-- REGISTER PAGE -->
<!-- ===================================================== -->

<section class="container py-5 min-vh-100 d-flex align-items-center">

	<div class="row g-0 rounded-5 overflow-hidden shadow-lg border w-100">

		<!-- ===================================================== -->
		<!-- VISUAL SECTION -->
		<!-- ===================================================== -->

		<div class="col-lg-7 d-none d-lg-block position-relative overflow-hidden">

			<!-- BACKGROUND IMAGE -->
			<img
				src="/img/sign-up.png"
				alt="Fresh ingredients and cooking preparation"
				class="img-fluid w-100 h-100 object-fit-cover"
				style="min-height: 950px" />

			<!-- DARK OVERLAY -->
			<div
				class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50">
			</div>

			<!-- OVERLAY CONTENT -->
			<div
				class="position-absolute top-50 start-50 translate-middle text-white text-center px-5 w-100">

				<span class="badge bg-white text-dark rounded-pill px-3 py-2 mb-4">
					START YOUR COOKING JOURNEY
				</span>

				<h2 class="display-5 fw-bold mb-4">
					Share Your Recipes With The World.
				</h2>

				<p class="fs-5 text-light opacity-75 col-lg-8 mx-auto mb-0">
					Create your free account and publish your favorite dishes for thousands
					of food lovers to discover.
				</p>

			</div>

		</div>



		<!-- ===================================================== -->
		<!-- REGISTER FORM SECTION -->
		<!-- ===================================================== -->

		<div class="col-lg-5 d-flex align-items-center">

			<div
				class="w-100 p-4 p-lg-5 mx-auto"
				style="max-width: 500px">

				<!-- ===================================================== -->
				<!-- REGISTER HEADER -->
				<!-- ===================================================== -->

				<div class="mb-5 text-center text-lg-start">

					<span class="badge text-bg-light border rounded-pill px-3 py-2 mb-4">
						CREATE ACCOUNT
					</span>

					<h1 class="fw-bold display-6 mb-3">
						Join The Community
					</h1>

					<p class="text-secondary mb-0">
						Create your account to publish recipes and explore cuisines from around the world.
					</p>

				</div>



				<!-- ===================================================== -->
				<!-- REGISTER FORM -->
				<!-- ===================================================== -->

				<form
					action="/sign-up"
					method="POST"
					id="signUpForm"
					novalidate>



					<!-- ===================================================== -->
					<!-- FULL NAME -->
					<!-- ===================================================== -->

					<div class="mb-4">

						<label
							for="name"
							class="form-label fw-semibold">

							Full Name

						</label>

						<div class="input-group shadow-sm">

							<span class="input-group-text bg-white border-end-0">
								<i class="bi bi-person text-secondary"></i>
							</span>

							<input
								type="text"
								id="name"
								name="name"
								autocomplete="name"
								value="<%= oldValues.name || '' %>"
								class="form-control border-start-0 py-3 <%= validationErrors.name ? 'is-invalid' : '' %>"
								placeholder="Enter your full name" />

						</div>

						<small
							id="nameError"
							class="invalid-feedback d-block">

							<%= validationErrors.name || '' %>

						</small>

					</div>



					<!-- ===================================================== -->
					<!-- EMAIL -->
					<!-- ===================================================== -->

					<div class="mb-4">

						<label
							for="email"
							class="form-label fw-semibold">

							Email Address

						</label>

						<div class="input-group shadow-sm">

							<span class="input-group-text bg-white border-end-0">
								<i class="bi bi-envelope text-secondary"></i>
							</span>

							<input
								type="email"
								id="email"
								name="email"
								autocomplete="email"
								value="<%= oldValues.email || '' %>"
								class="form-control border-start-0 py-3 <%= validationErrors.email ? 'is-invalid' : '' %>"
								placeholder="Enter your email address" />

						</div>

						<small
							id="emailError"
							class="invalid-feedback d-block">

							<%= validationErrors.email || '' %>

						</small>

					</div>



					<!-- ===================================================== -->
					<!-- PASSWORD -->
					<!-- ===================================================== -->

					<div class="mb-4">

						<label
							for="password"
							class="form-label fw-semibold">

							Password

						</label>

						<div class="input-group shadow-sm">

							<span class="input-group-text bg-white border-end-0">
								<i class="bi bi-lock text-secondary"></i>
							</span>

							<input
								type="password"
								id="password"
								name="password"
								autocomplete="new-password"
								class="form-control border-start-0 py-3 <%= validationErrors.password ? 'is-invalid' : '' %>"
								placeholder="Create a password" />

						</div>

						<small
							id="passwordError"
							class="invalid-feedback d-block">

							<%= validationErrors.password || '' %>

						</small>

					</div>



					<!-- ===================================================== -->
					<!-- CONFIRM PASSWORD -->
					<!-- ===================================================== -->

					<div class="mb-4 																																									">

						<label
							for="confirmPassword"
							class="form-label fw-semibold">

							Confirm Password

						</label>

						<div class="input-group shadow-sm">

							<span class="input-group-text bg-white border-end-0">
								<i class="bi bi-shield-lock text-secondary"></i>
							</span>

							<input
								type="password"
								id="confirmPassword"
								name="confirmPassword"
								autocomplete="new-password"
								class="form-control border-start-0 py-3 <%= validationErrors.confirmPassword ? 'is-invalid' : '' %>"
								placeholder="Confirm your password" />

						</div>

						<small
							id="confirmPasswordError"
							class="invalid-feedback d-block">


						</small>

					</div>



					<!-- ===================================================== -->
					<!-- TERMS CHECKBOX -->
					<!-- ===================================================== -->

					<div class="form-check mb-4">

						<input
							class="form-check-input"
							type="checkbox"
							id="termsAgreement" />

						<label
							class="form-check-label text-secondary"
							for="termsAgreement">

							I agree to the

							<a
								href="/terms"
								class="text-dark text-decoration-none fw-semibold">

								Terms & Conditions

							</a>

						</label>

					</div>



					<!-- ===================================================== -->
					<!-- SUBMIT BUTTON -->
					<!-- ===================================================== -->

					<div class="d-grid mb-4">

						<button
							type="submit"
							class="btn btn-dark btn-lg rounded-pill py-3 shadow-sm">

							<i class="bi bi-person-plus me-2"></i>

							Create Account

						</button>

					</div>



					<!-- ===================================================== -->
					<!-- LOGIN LINK -->
					<!-- ===================================================== -->

					<p class="text-center text-secondary mb-0 pt-2">

						Already have an account?

						<a
							href="/sign-in"
							class="fw-semibold text-dark text-decoration-none">

							Sign In

						</a>

					</p>

				</form>

			</div>

		</div>

	</div>

</section>



<!-- ===================================================== -->
<!-- FRONTEND VALIDATION -->
<!-- ===================================================== -->
<!-- Load scripts in order -->
<script type="module" src="/js/signUpForm.js" ></script>
