<!-- ===================================================== -->
<!-- REGISTER PAGE -->
<!-- ===================================================== -->

<section class="container  py-5">

	<div class="row g-0 rounded-5 overflow-hidden">

		<!-- ===================================================== -->
		<!-- VISUAL SECTION -->
		<!-- ===================================================== -->

		<div class="col-lg-7 d-none d-lg-block position-relative overflow-hidden">

			<!-- BACKGROUND IMAGE -->
			<img
				src="img/cooking-content-creator-removebg-preview.png"
				alt="Fresh ingredients and cooking preparation"
				class="img-fluid w-100 h-100 object-fit-contain"
				style="min-height: 950px" />

		</div>



		<!-- ===================================================== -->
		<!-- REGISTER FORM SECTION -->
		<!-- ===================================================== -->

		<div class="col-lg-5 d-flex align-items-center">

			<div
				class="w-100 p-4 p-lg-5 mx-auto"
				style="max-width: 500px">

				<!-- REGISTER HEADER -->
				<div class="mb-5 text-center text-lg-start">

					<span class="badge text-bg-light border rounded-pill px-3 py-2 mb-4">
						CREATE ACCOUNT
					</span>

					<h1 class="fw-bold display-6 mb-3">
						Join The Community
					</h1>

					<p class="text-secondary mb-0">
						Create your account to publish recipes and explore cuisines from around the world.
					</p>

				</div>



				<!-- ===================================================== -->
				<!-- REGISTER FORM -->
				<!-- ===================================================== -->

				<form>

					<!-- FULL NAME -->
					<div class="mb-4">

						<label
							for="fullName"
							class="form-label fw-semibold">

							Full Name

						</label>

						<div class="input-group shadow-sm">

							<span class="input-group-text bg-white border-end-0">
								<i class="bi bi-person text-secondary"></i>
							</span>

							<input
								type="text"
								id="fullName"
								name="fullName"
								autocomplete="name"
								class="form-control border-start-0 py-3"
								placeholder="Enter your full name" />

						</div>

					</div>



					<!-- EMAIL -->
					<div class="mb-4">

						<label
							for="email"
							class="form-label fw-semibold">

							Email Address

						</label>

						<div class="input-group shadow-sm">

							<span class="input-group-text bg-white border-end-0">
								<i class="bi bi-envelope text-secondary"></i>
							</span>

							<input
								type="email"
								id="email"
								name="email"
								autocomplete="email"
								class="form-control border-start-0 py-3"
								placeholder="Enter your email address" />

						</div>

					</div>



					<!-- PASSWORD -->
					<div class="mb-4">

						<label
							for="password"
							class="form-label fw-semibold">

							Password

						</label>

						<div class="input-group shadow-sm">

							<span class="input-group-text bg-white border-end-0">
								<i class="bi bi-lock text-secondary"></i>
							</span>

							<input
								type="password"
								id="password"
								name="password"
								autocomplete="new-password"
								class="form-control border-start-0 py-3"
								placeholder="Create a password" />

						</div>

					</div>



					<!-- CONFIRM PASSWORD -->
					<div class="mb-4">

						<label
							for="confirmPassword"
							class="form-label fw-semibold">

							Confirm Password

						</label>

						<div class="input-group shadow-sm">

							<span class="input-group-text bg-white border-end-0">
								<i class="bi bi-shield-lock text-secondary"></i>
							</span>

							<input
								type="password"
								id="confirmPassword"
								name="confirmPassword"
								autocomplete="new-password"
								class="form-control border-start-0 py-3"
								placeholder="Confirm your password" />

						</div>

					</div>



					<!-- TERMS CHECKBOX -->
					<div class="form-check mb-4">

						<input
							class="form-check-input"
							type="checkbox"
							id="termsAgreement" />

						<label
							class="form-check-label text-secondary"
							for="termsAgreement">

							I agree to the
							<a
								href="/terms"
								class="text-dark text-decoration-none fw-semibold">

								Terms & Conditions

							</a>

						</label>

					</div>



					<!-- REGISTER BUTTON -->
					<div class="d-grid mb-4">

						<button
							type="submit"
							class="btn btn-dark btn-lg rounded-pill py-3 shadow-sm">

							<i class="bi bi-person-plus me-2"></i>

							Create Account

						</button>

					</div>



					<!-- DIVIDER -->
					<div class="d-flex align-items-center gap-3 mb-4">

						<hr class="flex-grow-1 opacity-25" />

						<span class="text-secondary small">
							OR
						</span>

						<hr class="flex-grow-1 opacity-25" />

					</div>



					<!-- SOCIAL REGISTER -->
					<div class="row g-3 mb-4">

						<div class="col-6">

							<button
								type="button"
								class="btn btn-outline-dark w-100 py-3 rounded-pill">

								<i class="bi bi-google me-2"></i>

								Google

							</button>

						</div>


						<div class="col-6">

							<button
								type="button"
								class="btn btn-outline-dark w-100 py-3 rounded-pill">

								<i class="bi bi-facebook me-2"></i>

								Facebook

							</button>

						</div>

					</div>



					<!-- LOGIN LINK -->
					<p class="text-center text-secondary mb-0 pt-2">

						Already have an account?

						<a
							href="/login"
							class="fw-semibold text-dark text-decoration-none">

							Sign In

						</a>

					</p>

				</form>

			</div>

		</div>

	</div>

</section>