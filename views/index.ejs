<!-- HERO SECTION -->
<section class="hero-section row flex-lg-row-reverse align-items-center g-5 py-5 mb-5">

  <div class="col-12 col-lg-6">

    <div class="position-relative">

      <img
        src="/img/hero-image.png"
        width="607"
        height="510"
        class="d-block mx-auto img-fluid rounded-5 hero-image"
        loading="eager"
        alt="Delicious homemade food prepared by a chef"
      />

      <div class="position-absolute bottom-0 start-0 translate-middle-y bg-white shadow rounded-4 p-4 d-none d-md-block">
        <h5 class="fw-bold mb-1">
          Publish Recipes For Free
        </h5>

        <p class="text-secondary small mb-0">
          Inspire food lovers through your cooking creativity.
        </p>
      </div>

    </div>

  </div>

  <div class="col-12 col-lg-6">

    <span class="badge text-bg-dark rounded-pill px-3 py-2 mb-4">
      Discover • Cook • Publish
    </span>

    <h1 class="display-3 fw-bold lh-1 mb-4">
      Share Your Recipes With Food Lovers Around The World
    </h1>

    <p class="lead text-secondary mb-4">
      Discover authentic recipes from different cultures or publish your own
      dishes for free. Inspire thousands of visitors through your cooking creativity.
    </p>

    <div class="d-flex flex-wrap gap-3">

      <a
        href="/explore-latest"
        class="btn btn-dark btn-lg  px-4 hero-btn"
      >
        Explore Recipes
      </a>

      <a
        href="/submit-recipe"
        class="btn btn-outline-dark btn-lg  px-4 hero-btn"
      >
        Publish Recipe
      </a>

    </div>

  </div>

</section>

<!-- STATS SECTION -->
<section class="stats-section bg-light border rounded-5 py-4 px-3 mb-5">

  <div class="row row-cols-1 row-cols-sm-3 g-4 text-center">

    <div class="col">

      <div class="stats-card bg-white p-4 rounded-4 shadow-sm h-100">

        <h3 class="fw-bold mb-1">
          2K+
        </h3>

        <small class="text-secondary">
          Published Recipes
        </small>

      </div>

    </div>

    <div class="col">

      <div class="stats-card bg-white p-4 rounded-4 shadow-sm h-100">

        <h3 class="fw-bold mb-1">
          50+
        </h3>

        <small class="text-secondary">
          Food Categories
        </small>

      </div>

    </div>

    <div class="col">

      <div class="stats-card bg-white p-4 rounded-4 shadow-sm h-100">

        <h3 class="fw-bold mb-1">
          10K+
        </h3>

        <small class="text-secondary">
          Monthly Visitors
        </small>

      </div>

    </div>

  </div>

</section>

<!-- CATEGORY SECTION -->
<section class="py-4 mb-4">
  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h2 class="fw-bold mb-1">
        Explore Categories
      </h2>

      <p class="text-secondary mb-0">
        Discover recipes by cuisine and food type.
      </p>
    </div>

    <a href="/categories"
      class="btn btn-outline-dark rounded-pill">
      View All
    </a>

  </div>

<div class="row row-cols-2 row-cols-lg-6 g-2 g-lg-3 py-4">
  <% if (categories?.length) {%> 

    <% categories.forEach((category,index)=>{%>

  <a
    href="/categories/<%-category.name%>"
    class="col text-center category__link"
  >
    <div class="category__img shadow">
      <img
        src="/img/<%-category.image%>"
        loading="lazy"
        alt="<%-category.name%>"
      />
    </div>
    <div class="pt-1"><%-category.name%></div>
  </a>
  <%})%> 
  <% } else { %>

    <div class="alert alert-light border rounded-4 text-center py-4">
      No categories available right now.
    </div>

  <% } %>
</div>
</section>



<!-- LATEST RECIPES -->
<section class="py-5 mb-5">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>

      <h2 class="fw-bold mb-1">
        Latest Recipes
      </h2>

      <p class="text-secondary mb-0">
        Freshly published recipes from food creators.
      </p>

    </div>

    <a
      href="/explore-latest"
      class="btn btn-outline-dark rounded-pill"
    >
      View More
    </a>

  </div>


  <% if (recipes?.length) { %>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-5 g-4">

      <% recipes.forEach((recipe,index) => { %>

        <div class="col <%= recipes.length === index + 1 ? 'd-xl-none' : 'd-block' %>">

          <a
            href="/recipe/<%= recipe._id %>"
            class="text-decoration-none text-dark"
          >

            <div class="recipe-card card border-0 shadow-sm rounded-5 overflow-hidden h-100">

              <div class="ratio ratio-1x1">

                <img
                  src="/uploads/<%= recipe.image %>"
                  alt="<%= recipe.name %>"
                  class="recipe-image card-img-top object-fit-cover"
                  loading="lazy"
                />

              </div>

              <div class="card-body p-4">

                <div class="mb-3">

                  <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                    ★ <%= recipe?.rating || "4.5" %>
                  </span>

                </div>

                <h5 class="card-title fw-bold mb-2">

                  <%= recipe.name %>

                </h5>

                <p class="card-text text-secondary small mb-0">
                  Discover this delicious recipe and try it at home.
                </p>

              </div>

            </div>

          </a>

        </div>

      <% }) %>

    </div>

  <% } else { %>

    <div class="alert alert-light border rounded-4 text-center py-4">
      No recipes available right now.
    </div>

  <% } %>

</section>


