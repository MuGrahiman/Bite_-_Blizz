<!-- ===================================================== -->
<!-- LOGIN PAGE -->
<!-- ===================================================== -->

<section class="container py-5">


		<div class="row g-0  rounded-5 overflow-hidden ">


			<!-- ===================================================== -->
			<!-- VISUAL SECTION -->
			<!-- ===================================================== -->

			<div class="col-lg-7 d-none d-lg-block position-relative overflow-hidden">

				<!-- BACKGROUND IMAGE -->
				<img
					src="img/SIGNIN-SERVER-removebg-preview.png"
					alt="Cooking ingredients and food preparation"
					class="img-fluid w-100 h-100 object-fit-cover"
					style="min-height: 850px" />


			</div>

			<!-- ===================================================== -->
			<!-- LOGIN FORM SECTION -->
			<!-- ===================================================== -->

			<div class="col-lg-5 d-flex align-items-center">

				<div class="w-100 p-4 p-lg-5">

					<!-- LOGIN HEADER -->
					<div class="mb-5  text-center text-lg-start">

						<span class="badge text-bg-light border rounded-pill px-3 py-2 mb-5 mb-lg-3">
							WELCOME BACK
						</span>

						<h1 class="fw-bold display-6 mb-3">
							Sign In
						</h1>

						<p class="text-secondary mb-0">
							Continue exploring and sharing delicious recipes from around the world.
						</p>

					</div>



					<!-- ===================================================== -->
					<!-- LOGIN FORM -->
					<!-- ===================================================== -->

					<form>

						<!-- EMAIL FIELD -->
						<div class="mb-4">

							<label class="form-label fw-semibold">
								Email Address
							</label>

							<div class="input-group">

								<span class="input-group-text bg-white border-end-0">
									<i class="bi bi-envelope text-secondary"></i>
								</span>

								<input
									type="email"
									class="form-control border-start-0 py-3"
									placeholder="Enter your email address" />

							</div>

						</div>



						<!-- PASSWORD FIELD -->
						<div class="mb-2">

							<label class="form-label fw-semibold">
								Password
							</label>

							<div class="input-group">

								<span class="input-group-text bg-white border-end-0">
									<i class="bi bi-lock text-secondary"></i>
								</span>

								<input
									type="password"
									class="form-control border-start-0 py-3"
									placeholder="Enter your password" />

							</div>

						</div>



						<!-- FORGOT PASSWORD -->
						<div class="text-center mb-4">

							<a
								href="/forgot-password"
								class="small  text-decoration-none text-primary">

								Forgot Password?

							</a>

						</div>

						<!-- LOGIN BUTTON -->
						<div class="d-grid mb-4">

							<button
								type="submit"
								class="btn btn-dark btn-lg rounded-pill py-3 shadow-sm">

								<i class="bi bi-box-arrow-in-right me-2"></i>

								Sign In

							</button>

						</div>



						<!-- DIVIDER -->
						<div class="d-flex align-items-center gap-3 mb-4">

							<hr class="flex-grow-1 opacity-25" />

							<span class="text-secondary small">
								OR
							</span>

							<hr class="flex-grow-1 opacity-25" />

						</div>



						<!-- SOCIAL LOGIN -->
						<div class="row g-3 mb-4">

							<div class="col-6">

								<button
									type="button"
									class="btn btn-outline-secondary w-100 py-3 rounded-pill">

									<i class="bi bi-google me-2"></i>

									Google

								</button>

							</div>


							<div class="col-6">

								<button
									type="button"
									class="btn btn-outline-secondary w-100 py-3 rounded-pill">

									<i class="bi bi-facebook me-2"></i>

									Facebook

								</button>

							</div>

						</div>



						<!-- REGISTER LINK -->
						<p class="text-center text-secondary mb-0">

							Don’t have an account?

							<a
								href="/register"
								class="fw-semibold text-dark text-decoration-none">

								Create Account

							</a>

						</p>

					</form>

				</div>

			</div>


		</div>


</section>