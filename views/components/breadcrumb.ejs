
<!-- breadcrumb-items -->
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Home</a></li>
    <% if (items) { %>
      <% if (Array.isArray(items)) { %>
        <% items.forEach((item) => { %>
          <% if (item.path) { %>
            <li class="breadcrumb-item"><a href="<%= item.path %>"> <%= item.label %></a></li>
          <% } else { %>
            <li class="breadcrumb-item active" aria-current="page"><%= item.label %></li>
          <% } %>
        <% }); %>
      <% } else { %>
        <% if (items.path) { %>
          <li class="breadcrumb-item"><a href="<%= items.path %>"> <%= items.label %></a></li>
        <% } else { %>
          <li class="breadcrumb-item active" aria-current="page"><%= items.label %></li>
        <% } %>
      <% } %>
    <% } %>
  </ol>
</nav>
