
	<!-- ===================================================== -->
	<!-- FORGOT PASSWORD PAGE -->
	<!-- ===================================================== -->

	<section class="container py-5 min-vh-100 d-flex align-items-center">

		<div class="row g-0 rounded-5 overflow-hidden shadow-lg border w-100">

			<!-- ===================================================== -->
			<!-- VISUAL SECTION -->
			<!-- ===================================================== -->

			<div class="col-lg-7 d-none d-lg-block position-relative overflow-hidden">

				<!-- BACKGROUND IMAGE -->
				<img
					src="img/forgot-password.png"
				class="img-fluid w-100 h-100 object-fit-cover"
					alt="Cooking ingredients on kitchen table"
					class="img-fluid w-100 h-100 object-fit-contain"
					style="min-height: 850px" />

				<!-- DARK OVERLAY -->
				<div
					class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50">
				</div>

				<!-- VISUAL CONTENT -->
				<div
					class="position-absolute top-50 start-50 translate-middle text-center text-white px-5 w-100">

					<span class="badge bg-white text-dark rounded-pill px-3 py-2 mb-4">
						ACCOUNT RECOVERY
					</span>

					<h2 class="display-5 fw-bold mb-4">
						Reset Your Password Securely.
					</h2>

					<p class="fs-5 text-light opacity-75 col-lg-9 mx-auto mb-0">
						Enter your registered email address and we’ll send you a secure
						link to reset your password and get back to sharing recipes.
					</p>

				</div>

			</div>



			<!-- ===================================================== -->
			<!-- FORM SECTION -->
			<!-- ===================================================== -->

			<div class="col-lg-5 d-flex align-items-center bg-white">

				<div
					class="w-100 p-4 p-lg-5 mx-auto"
					style="max-width: 500px">

					<!-- PAGE HEADER -->
					<div class="mb-5 text-center text-lg-start">

						<span
							class="badge text-bg-light border rounded-pill px-3 py-2 mb-4">

							FORGOT PASSWORD

						</span>

						<h1 class="fw-bold display-6 mb-3">
							Recover Your Account
						</h1>

						<p class="text-secondary mb-0">
							No worries. Enter your registered email address and we’ll help
							you reset your password securely.
						</p>

					</div>



					<!-- ===================================================== -->
					<!-- FORGOT PASSWORD FORM -->
					<!-- ===================================================== -->

					<form action="/forgot-password" method="POST">

						<!-- EMAIL FIELD -->
						<div class="mb-4">

							<label
								for="email"
								class="form-label fw-semibold">

								Registered Email Address

							</label>

							<div class="input-group shadow-sm">

								<span class="input-group-text bg-white border-end-0">
									<i class="bi bi-envelope text-secondary"></i>
								</span>

								<input
									type="email"
									id="email"
									name="email"
									autocomplete="email"
									class="form-control border-start-0 py-3"
									placeholder="Enter your email address"
									required />

							</div>

						</div>



						<!-- HELP TEXT -->
						<div class="mb-4">

							<p class="small text-secondary mb-0">
								We’ll send a password reset link to your inbox.
							</p>

						</div>



						<!-- SUBMIT BUTTON -->
						<div class="d-grid mb-4">

							<button
								type="submit"
								class="btn btn-dark btn-lg rounded-pill py-3 shadow-sm">

								<i class="bi bi-arrow-repeat me-2"></i>

								Send Reset Link

							</button>

						</div>



						<!-- DIVIDER -->
						<div class="d-flex align-items-center gap-3 mb-4">

							<hr class="flex-grow-1 opacity-25" />

							<span class="text-secondary small">
								OR
							</span>

							<hr class="flex-grow-1 opacity-25" />

						</div>



						<!-- BACK TO LOGIN -->
						<div class="text-center">

							<p class="text-secondary mb-0">

								Remember your password?

								<a
									href="/sign-in"
									class="fw-semibold text-dark text-decoration-none">

									Back To Login

								</a>

							</p>

						</div>

					</form>

				</div>

			</div>

		</div>

	</section>

