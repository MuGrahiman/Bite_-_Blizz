<!-- ===================================================== -->
<!-- RESET PASSWORD PAGE -->
<!-- ===================================================== -->

<section class="container py-5 min-vh-100 d-flex align-items-center">

	<div class="row g-0 rounded-5 overflow-hidden shadow-lg border w-100">

		<!-- ===================================================== -->
		<!-- VISUAL SECTION -->
		<!-- ===================================================== -->

		<div class="col-lg-7 d-none d-lg-block position-relative overflow-hidden">

			<!-- BACKGROUND IMAGE -->
			<img
				src="img/reset-password.png"
				class="img-fluid w-100 h-100 object-fit-cover"
				style="min-height: 900px" />



			<!-- DARK OVERLAY -->
			<div
				class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50">
			</div>



			<!-- VISUAL CONTENT -->
			<div
				class="position-absolute top-50 start-50 translate-middle text-white text-center px-5 w-100">

				<span class="badge bg-white text-dark rounded-pill px-3 py-2 mb-4">
					SECURE ACCOUNT RECOVERY
				</span>

				<h2 class="display-4 fw-bold mb-4">
					Create A New Password.
				</h2>

				<p class="fs-5 text-light opacity-75 col-lg-9 mx-auto mb-0">
					Choose a strong password to protect your account and continue
					sharing delicious recipes with food lovers worldwide.
				</p>

			</div>

		</div>



		<!-- ===================================================== -->
		<!-- RESET PASSWORD FORM SECTION -->
		<!-- ===================================================== -->

		<div class="col-lg-5 d-flex align-items-center bg-white">

			<div
				class="w-100 p-4 p-lg-5 mx-auto"
				style="max-width: 500px">

				<!-- PAGE HEADER -->
				<div class="mb-5 text-center text-lg-start">

					<span
						class="badge text-bg-light border rounded-pill px-3 py-2 mb-4">

						RESET PASSWORD

					</span>

					<h1 class="fw-bold display-6 mb-3">
						Set New Password
					</h1>

					<p class="text-secondary mb-0">
						Your new password should be secure, memorable, and different
						from previously used passwords.
					</p>

				</div>



				<!-- ===================================================== -->
				<!-- RESET PASSWORD FORM -->
				<!-- ===================================================== -->

				<form action="/reset-password" method="POST">

					<!-- NEW PASSWORD -->
					<div class="mb-4">

						<label
							for="newPassword"
							class="form-label fw-semibold">

							New Password

						</label>

						<div class="input-group shadow-sm">

							<span class="input-group-text bg-white border-end-0">
								<i class="bi bi-lock text-secondary"></i>
							</span>

							<input
								type="password"
								id="newPassword"
								name="newPassword"
								autocomplete="new-password"
								class="form-control border-start-0 py-3"
								placeholder="Enter your new password"
								required />

						</div>

					</div>



					<!-- CONFIRM PASSWORD -->
					<div class="mb-4">

						<label
							for="confirmPassword"
							class="form-label fw-semibold">

							Confirm Password

						</label>

						<div class="input-group shadow-sm">

							<span class="input-group-text bg-white border-end-0">
								<i class="bi bi-shield-lock text-secondary"></i>
							</span>

							<input
								type="password"
								id="confirmPassword"
								name="confirmPassword"
								autocomplete="new-password"
								class="form-control border-start-0 py-3"
								placeholder="Confirm your new password"
								required />

						</div>

					</div>



					<!-- PASSWORD REQUIREMENTS -->
					<div class="bg-light rounded-4 p-4 mb-4 border">

						<h6 class="fw-bold mb-3">
							Password Requirements
						</h6>

						<ul class="list-unstyled text-secondary small mb-0">

							<li class="mb-2">
								<i class="bi bi-check-circle-fill text-success me-2"></i>
								At least 8 characters long
							</li>

							<li class="mb-2">
								<i class="bi bi-check-circle-fill text-success me-2"></i>
								Include uppercase and lowercase letters
							</li>

							<li class="mb-2">
								<i class="bi bi-check-circle-fill text-success me-2"></i>
								Include at least one number
							</li>

							<li>
								<i class="bi bi-check-circle-fill text-success me-2"></i>
								Include one special character
							</li>

						</ul>

					</div>



					<!-- SUBMIT BUTTON -->
					<div class="d-grid mb-4">

						<button
							type="submit"
							class="btn btn-dark btn-lg rounded-pill py-3 shadow-sm">

							<i class="bi bi-shield-lock me-2"></i>

							Update Password

						</button>

					</div>



					<!-- DIVIDER -->
					<div class="d-flex align-items-center gap-3 mb-4">

						<hr class="flex-grow-1 opacity-25" />

						<span class="text-secondary small">
							OR
						</span>

						<hr class="flex-grow-1 opacity-25" />

					</div>



					<!-- BACK TO LOGIN -->
					<div class="text-center">

						<p class="text-secondary mb-0">

							Remember your password?

							<a
								href="/sign-in"
								class="fw-semibold text-dark text-decoration-none">

								Back To Login

							</a>

						</p>

					</div>

				</form>

			</div>

		</div>

	</div>

</section>