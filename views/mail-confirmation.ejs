<!-- ===================================================== -->
<!-- DYNAMIC AUTHENTICATION EMAIL PAGE -->
<!-- ===================================================== -->
<%
	const authType =
		typeof type !== 'undefined'
			? type
			: 'verify';

	const userEmail =
		typeof email !== 'undefined'
			? email
			: 'user@example.com';

	const authContent = {

		reset: {
			leftBadge: 'PASSWORD RECOVERY',

			leftTitle: 'Password Reset Sent Successfully',

			leftDescription:
				'We’ve securely sent a password reset link to your email address. Open your inbox and follow the instructions to regain access to your account.',

			rightBadge: 'CHECK YOUR EMAIL',

			rightTitle: 'Open Your Inbox',

			rightDescription:
				'We’ve sent a password reset link to:',

			helpText:
				'If you don’t see the email within a few minutes, check your spam, junk, or promotions folder.',

			resendLink: '/forgot-password',

			loginText: 'Remember your password?',

			loginLinkText: 'Back To Login'
		},

		verify: {
			leftBadge: 'EMAIL VERIFICATION',

			leftTitle: 'Verify Your Account',

			leftDescription:
				'We’ve securely sent an account verification link to your email address. Open your inbox and verify your account to start exploring and sharing recipes.',

			rightBadge: 'VERIFY YOUR EMAIL',

			rightTitle: 'Check Your Inbox',

			rightDescription:
				'We’ve sent an account verification link to:',

			helpText:
				'If you don’t see the email within a few minutes, check your spam, junk, or promotions folder.',

			resendLink: '/register',

			loginText: 'Already verified your account?',

			loginLinkText: 'Continue To Login'
		}
	};

	const content = authContent[authType];
%>

<section class="container py-5">
	<div class="row justify-content-center">
		<div class="col-12 col-xl-10">
			<div class="row g-0 bg-white border shadow-sm rounded-5 overflow-hidden">
				<!-- ===================================================== -->
				<!-- CONFIRMATION INFO SECTION -->
				<!-- ===================================================== -->

				<div
					class="col-lg-6 d-flex align-items-center justify-content-center bg-light border-end">
					<div class="text-center p-4 p-lg-5 w-100" style="max-width: 540px">
						<!-- STATUS BADGE -->
						<span class="badge text-bg-dark rounded-pill px-3 py-2 mb-4">
							<%= content.leftBadge %>
						</span>

						<!-- SECTION TITLE -->
						<h1 class="display-5 fw-bold mb-4"><%= content.leftTitle %></h1>

						<!-- SUCCESS ICON -->
						<div
							class="floating bg-dark text-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm mb-4"
							style="width: 110px; height: 110px">
							<i class="bi bi-envelope-check fs-1"></i>
						</div>

						<!-- SECTION DESCRIPTION -->
						<p class="fs-5 text-secondary col-lg-10 mx-auto mb-0">
							<%= content.leftDescription %>
						</p>
					</div>
				</div>

				<!-- ===================================================== -->
				<!-- EMAIL ACTION SECTION -->
				<!-- ===================================================== -->

				<div class="col-lg-6 d-flex align-items-center">
					<div
						class="w-100 p-4 p-lg-5 mx-auto text-center"
						style="max-width: 540px">
						<!-- PAGE BADGE -->
						<span
							class="badge text-bg-light border rounded-pill px-3 py-2 mb-4">
							<%= content.rightBadge %>
						</span>

						<!-- PAGE TITLE -->
						<h2 class="fw-bold display-6 mb-4"><%= content.rightTitle %></h2>

						<!-- DESCRIPTION -->
						<p class="text-secondary fs-5 mb-4">
							<%= content.rightDescription %>
						</p>

						<!-- EMAIL DISPLAY -->
						<div class="bg-light border rounded-4 py-3 px-4 mb-4">
							<p class="fw-semibold text-dark mb-0"><%= userEmail %></p>
						</div>

						<!-- HELP TEXT -->
						<p class="text-secondary mb-5"><%= content.helpText %></p>

						<!-- ===================================================== -->
						<!-- ACTION BUTTONS -->
						<!-- ===================================================== -->

						<div class="d-grid gap-3">
							<!-- OPEN EMAIL BUTTON -->
							<a
								href="https://mail.google.com"
								target="_blank"
								class="btn btn-dark btn-lg rounded-pill py-3 shadow-sm">
								<i class="bi bi-envelope-open me-2"></i>

								Open Email Inbox
							</a>

							<!-- RESEND EMAIL BUTTON -->
							<a
								href="<%= content.resendLink %>"
								class="btn btn-outline-dark btn-lg rounded-pill py-3">
								<i class="bi bi-arrow-repeat me-2"></i>

								Resend Email
							</a>
						</div>

						<!-- ===================================================== -->
						<!-- LOGIN REDIRECT -->
						<!-- ===================================================== -->

						<div class="mt-5">
							<p class="text-secondary mb-0">
								<%= content.loginText %>

								<a
									href="/login"
									class="fw-semibold text-dark text-decoration-none">
									<%= content.loginLinkText %>
								</a>
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
